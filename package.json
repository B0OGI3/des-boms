{
  "name": "des-boms",
  "version": "0.5.0",
  "description": "Delivered Engineering Solutions - Batch Order Management System for manufacturing operations",
  "private": true,
  "author": "B0OGI3",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "verify-hierarchy": "tsx scripts/verify-hierarchy.ts",
    "verify-organization": "tsx scripts/verify-organization.ts",
    "check-structure": ".\\scripts\\pre-commit-structure-check.bat",
    "security-check": ".\\scripts\\security-check.bat",
    "cleanup": ".\\scripts\\cleanup-dev.bat",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "docker:dev": "docker-compose up -d",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:stop": "docker-compose down",
    "docker:clean": "docker-compose down -v",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "pre-commit": "npm run lint && npm run type-check && npm run format:check",
    "prepare": "husky"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@mantine/core": "^8.2.7",
    "@mantine/hooks": "^8.2.7",
    "@mantine/modals": "^8.2.7",
    "@mantine/notifications": "^8.2.7",
    "@prisma/client": "^6.14.0",
    "@tabler/icons-react": "^3.43.0",
    "@types/pdfkit": "^0.17.2",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.16.0",
    "intuit-oauth": "^4.2.3",
    "js-cookie": "^3.0.5",
    "next": "^16.2.5",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-number-format": "^5.4.5",
    "react-qr-code": "^2.0.21",
    "react-remove-scroll": "^2.7.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.2.1",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.2",
    "husky": "^9.1.7",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^6.14.0",
    "tailwindcss": "^4.1.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "jws": ">=3.2.3",
      "tar": ">=7.5.8",
      "diff": ">=4.0.4",
      "js-yaml": ">=4.1.1"
    }
  }
}
