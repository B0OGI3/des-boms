{
  "name": "des-boms",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:generate": "pnpm --filter @des-boms/shared db:generate",
    "db:migrate": "pnpm --filter @des-boms/shared db:migrate",
    "db:deploy": "pnpm --filter @des-boms/shared db:deploy",
    "db:seed": "pnpm --filter @des-boms/shared db:seed",
    "db:studio": "pnpm --filter @des-boms/shared db:studio"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.4",
    "prettier": "^3.6.2",
    "turbo": "^2.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8"
  },
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.1.0",
      "file-type": ">=21.3.2",
      "glob": ">=10.5.0",
      "picomatch": ">=4.0.4",
      "uuid": ">=11.1.1",
      "tmp": ">=0.2.4",
      "webpack": ">=5.104.1",
      "esbuild": ">=0.25.0"
    }
  }
}
