# Database (used by docker-compose and Prisma)
POSTGRES_USER=desadmin
POSTGRES_PASSWORD=postgres
POSTGRES_DB=boms
DATABASE_URL="postgresql://desadmin:postgres@localhost:5432/boms"

# API
PORT=3001
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# QuickBooks (optional — app works without it)
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=http://localhost:3001/api/quickbooks/callback
QB_ENVIRONMENT=sandbox
